{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "noImplicitAny": true,
        "sourceMap": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "dst",
        "noUnusedLocals": true,
        "experimentalDecorators": true,
        "strict": true,
        "plugins": [
            { "transform": "./transformer/index.js" }
        ]
    },
    "exclude": [
        "**/__test__/"
    ],
    "include": [
        "src/**/*"
    ]
}
